PORT=3000
PROCESS_ROLE=all
DATABASE_URL=postgres://sellable:sellable@db:5432/sellable
REDIS_URL=redis://redis:6379
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
RAZORPAY_MODE=test
LIVE_MODE_ACK=false
ENABLE_DEV_TOOLS=true
APP_ENCRYPTION_KEY=base64_32byte_key
ADMIN_EMAIL=admin@sellable.dev
ADMIN_PASSWORD=change_me_before_share
SESSION_SECRET=long_random_string_here
APP_SECRET=another_long_random_string_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
# Pinned model — do not change without provider verification (the doctor
# checks this exact name against the provider's /models list).
LLM_MODEL=bonsai-8b
BASE_URL=http://localhost:3000
ABANDON_MINUTES=1440
RETRY_TTL_MIN=10
HOLD_TTL_MIN=15
POLL_INTERVAL_SEC=60
DAILY_INCENTIVE_BUDGET_PAISE=500000
ALERT_WEBHOOK_URL=
# Secret server-to-server key for contact binding (the ingestion auth path).
# Must equal the merchant's `secret_server` track_keys row, which seed.ts
# (re)seeds to the demo value below. If you rotate the DB row, update this.
# Generate a fresh one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then store the SAME value in track_keys AND here. NEVER use in live mode.
SERVER_KEY=sellable-server-key-demo-2024
# Public site key for anonymous cart ingestion (X-Site-Key on /api/track/cart).
# Must equal the merchant's `public_site` track_keys row (seeded by seed.ts).
SITE_KEY=sellable-track-key-demo-2024
