{
  "name": "sellable",
  "version": "1.0.0",
  "description": "Production-grade AI Revenue Layer on Razorpay",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node-pg-migrate up --migrations-dir src/migrate --database-url-env DATABASE_URL",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ e2e/",
    "typecheck": "tsc --noEmit",
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "pg": "^8.13.0",
    "node-pg-migrate": "^7.7.0",
    "bullmq": "^5.25.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8",
    "argon2": "^0.41.1",
    "jose": "^5.9.0",
    "razorpay": "^2.9.4",
    "cookie-parser": "^1.4.6",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.7.0",
    "@types/nock": "^11.1.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1",
    "nock": "^13.5.5",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0"
  }
}
