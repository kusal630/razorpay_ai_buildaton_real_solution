{
  "name": "sellable",
  "version": "1.0.0",
  "description": "Governed AI revenue agent for Razorpay merchants: AI proposes, code approves, every rupee lands on a tamper-evident ledger",
  "keywords": ["razorpay", "ai-agent", "revenue-recovery", "ledger", "ecommerce"],
  "license": "MIT",
  "repository": "https://github.com/example/sellable",
  "engines": { "node": ">=20" },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "setup": "npx tsx --env-file=.env scripts/setup.ts",
    "migrate": "node-pg-migrate up --migrations-dir src/migrate --database-url-env DATABASE_URL",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ e2e/",
    "lint:claims": "npx tsx scripts/lint-claims.ts",
    "typecheck": "tsc --noEmit",
    "seed": "npx tsx --env-file=.env seed.ts",
    "reset:sample": "npx tsx --env-file=.env scripts/reset.ts",
    "doctor": "npx tsx --env-file=.env doctor.ts",
    "verify": "npx tsx --env-file=.env verify.ts",
    "demo:buyer": "npx tsx --env-file=.env scripts/demo-buyer.ts",
    "backtest": "npx tsx --env-file=.env scripts/backtest.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bullmq": "^5.25.0",
    "cookie-parser": "^1.4.6",
    "debug": "^4.4.3",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.0",
    "node-pg-migrate": "^7.7.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "razorpay": "^2.9.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "nock": "^13.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
